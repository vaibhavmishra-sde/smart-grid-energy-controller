DATABASE_PASSWORD=change_me_local_only
DATABASE_URL=postgresql://smart_grid:change_me_local_only@postgres:5432/smart_grid

SIMULATED_SENSORS=1000
TELEMETRY_INTERVAL_MS=1000
ENABLE_AUTO_PROTECTION=true
MAX_VOLTAGE=250
MIN_VOLTAGE=210
MAX_POWER=5000
JWT_SECRET=change_me_before_production
