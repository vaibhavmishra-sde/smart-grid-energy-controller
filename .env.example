PORT=5000
NODE_ENV=development

MQTT_HOST=mosquitto
MQTT_PORT=1883

REDIS_HOST=redis
REDIS_PORT=6379

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=smart_grid
